{% extends "module.html.twig" %}

{% block section %}
    <h2>Notifications</h2>

    <div class="mb-4">
        <p class="text-muted">
            Total Notifications: <strong>{{ totalCount }}</strong>
        </p>
    </div>

    {% if notifications|length > 0 %}
        <div class="table-responsive">
            <table class="table table-striped table-hover">
                <thead>
                    <tr>
                        <th>Timestamp</th>
                        <th>Level</th>
                        <th>Component</th>
                        <th>Title</th>
                        <th>Message</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    {% for notification in notifications %}
                        <tr class="{{ notification.read ? '' : 'fw-bold' }}">
                            <td>{{ notification.timestamp|date('Y-m-d H:i:s') }}</td>
                            <td>
                                {% if notification.level == 1 %}
                                    <span class="badge bg-danger">Error</span>
                                {% elseif notification.level == 2 %}
                                    <span class="badge bg-warning">Warning</span>
                                {% elseif notification.level == 3 %}
                                    <span class="badge bg-info">Info</span>
                                {% else %}
                                    <span class="badge bg-secondary">Debug</span>
                                {% endif %}
                            </td>
                            <td>{{ notification.component }}</td>
                            <td>{{ notification.title }}</td>
                            <td>{{ notification.message|truncate(100) }}</td>
                            <td>
                                {% if notification.read %}
                                    <span class="badge bg-secondary">Read</span>
                                {% else %}
                                    <span class="badge bg-primary">Unread</span>
                                {% endif %}
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    {% else %}
        <div class="alert alert-info">
            <strong>No notifications found.</strong>
            <p>Notifications will appear here once they are generated by the system.</p>
        </div>
    {% endif %}
{% endblock %}
